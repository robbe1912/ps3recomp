/* Production vertex profile block and indexed uploader; authored guest bytes. */
#include "rsx_commands.h"
#include "rsx_vertex_fetch.h"
#include "rsx_index_strip.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define VP_VERT_STRIDE 256u
typedef rsx_vertex_value VPSlot;
static struct { void* vp_vb_mapped; u32 vp_vb_offset, vp_parity, vp_capacity; } s_d3d;
static u8 guest[256 * 16];
uint8_t* vm_base = guest;
static u32 indices[4096];
static u64 clock_ticks;
static double perf_now(void) { return (double)clock_ticks++ * 0.000001; }
static u32 cellGcmResolveLocated(int location, u32 offset)
{ (void)location; return offset; }
static u32 read_guest_index(const rsx_state* state, u32 k)
{
    (void)state;
    return indices[k];
}
static void vp_upload_reserve(u64 count) { (void)count; }
static void reference_vertex(const rsx_state* state, u32 index, VPSlot* out)
{
    for (int attribute = 0; attribute < 16; ++attribute)
        rsx_fetch_attrib(state, attribute, index, out[attribute].v);
}
static void be32(u8* bytes, u32 word)
{
    bytes[0] = (u8)(word >> 24); bytes[1] = (u8)(word >> 16);
    bytes[2] = (u8)(word >> 8); bytes[3] = (u8)word;
}
@VERTEX_PROFILE_BLOCK@
void rsx_vtx_pos_dbg(const rsx_state* state, const float* v, u32 n)
{ (void)state; (void)v; (void)n; }
@INDEXED_STRIP_FUNCTION@
#define CHECK(condition) do { if (!(condition)) { \
    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); return 1; } } while (0)
static void setup(rsx_state* state)
{
    memset(state, 0, sizeof *state);
    state->vertex_attribs[0].enabled = 1;
    state->vertex_attribs[0].type = 2;
    state->vertex_attribs[0].size = 4;
    state->vertex_attribs[0].stride = 16;
    state->vertex_attribs[0].offset = 0x80000000u;
    for (u32 vertex = 0; vertex < 256; ++vertex) {
        float value[4] = { (float)vertex, -(float)vertex, 0.0f, 1.0f };
        for (int component = 0; component < 4; ++component) {
            u32 word; memcpy(&word, &value[component], 4);
            be32(guest + vertex * 16 + component * 4, word);
        }
    }
    indices[0] = 0; indices[1] = 1; indices[2] = 2; indices[3] = 3;
}
int main(int argc, char** argv)
{
    rsx_state state;
    rsx_vertex_profile_finish();
    setup(&state);
    s_d3d.vp_capacity = 4096;
    s_d3d.vp_vb_mapped = malloc(4096 * VP_VERT_STRIDE);
    CHECK(s_d3d.vp_vb_mapped);
    const int repeat = argc > 1 && !strcmp(argv[1], "repeat");
    const int direct = argc > 1 && !strcmp(argv[1], "direct");
    const int calls = repeat ? 3 : 1;
    for (int call = 0; call < calls; ++call) {
        if (call) ++state.begin_epoch;
        if (call) for (u32 vertex = 0; vertex < 256; ++vertex) {
            float value = (float)(vertex + 100 * call);
            u32 word; memcpy(&word, &value, 4);
            be32(guest + vertex * 16, word);
        }
        s_d3d.vp_vb_offset = 0;
        const u32 emitted = upload_strip_vp_indexed(&state, 0, direct ? 3 : 4, 0);
        CHECK(emitted == (direct ? 3u : 6u));
        const u32 order[] = { 0, 1, 2, 2, 1, 3 };
        for (u32 vertex = 0; vertex < emitted; ++vertex) {
            VPSlot expected[16];
            reference_vertex(&state, order[vertex], expected);
            CHECK(!memcmp((u8*)s_d3d.vp_vb_mapped + vertex * VP_VERT_STRIDE,
                          expected, sizeof expected));
        }
    }
    if (argc > 1 && !strcmp(argv[1], "reset")) rsx_vertex_profile_finish();
    rsx_vertex_profile_finish();
    printf("CLOCK %llu\n", (unsigned long long)clock_ticks);
    free(s_d3d.vp_vb_mapped);
    return 0;
}
